---
// A dev board with traces running to a sensor and an LED.
---

<svg class="diagram board" style="--vbw: 280" viewBox="0 0 280 120" role="img" aria-labelledby="board-title">
  <title id="board-title">A small development board with traces to a sensor and an LED.</title>
  <rect class="d-node" x="70" y="20" width="110" height="80" rx="8"></rect>
  <rect class="d-accent-soft" x="98" y="40" width="54" height="40" rx="4" stroke-width="1.25"></rect>
  {Array.from({ length: 6 }, (_, i) => (
    <>
      <circle class="d-node" cx={84 + i * 16} cy="28" r="2.5" />
      <circle class="d-node" cx={84 + i * 16} cy="92" r="2.5" />
    </>
  ))}
  <path class="d-line trace" d="M180 44 H214 V30 H236"></path>
  <path class="d-line trace" d="M180 76 H222 V92 H236"></path>
  <path class="d-line trace" d="M70 60 H32"></path>
  <rect class="d-node" x="236" y="18" width="30" height="24" rx="4"></rect>
  <text x="251" y="54" text-anchor="middle">
    sensor
  </text>
  <circle class="led" cx="248" cy="92" r="7"></circle>
  <circle class="d-node" cx="24" cy="60" r="8"></circle>
  <text x="24" y="84" text-anchor="middle">
    usb
  </text>
</svg>

<style>
  .led {
    fill: var(--status-active);
    opacity: 0.35;
    transition: opacity 0.3s ease;
  }

  .trace {
    stroke-dasharray: 4 3;
  }

  :global(.interest:hover) .led {
    opacity: 1;
  }

  :global(.interest:hover) .trace {
    stroke: var(--accent);
    animation: current 0.8s linear infinite;
  }

  @keyframes current {
    to {
      stroke-dashoffset: -14;
    }
  }
</style>
