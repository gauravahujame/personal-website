---
// One playable octave (C4–B4). A C major triad (C, E, G) is lit; hovering the card plays it as a
// ripple. Clicking, tapping or pressing Enter/Space on a key plays its note through the Web Audio API.
const WHITE = [
  { note: 'C', midi: 60 },
  { note: 'D', midi: 62 },
  { note: 'E', midi: 64 },
  { note: 'F', midi: 65 },
  { note: 'G', midi: 67 },
  { note: 'A', midi: 69 },
  { note: 'B', midi: 71 }
];
// `after` is the index of the white key each black key sits to the right of.
const BLACK = [
  { note: 'C♯', midi: 61, after: 0 },
  { note: 'D♯', midi: 63, after: 1 },
  { note: 'F♯', midi: 66, after: 3 },
  { note: 'G♯', midi: 68, after: 4 },
  { note: 'A♯', midi: 70, after: 5 }
];
const CHORD = new Set(['C', 'E', 'G']);
---

<svg class="diagram piano" style="--vbw: 280" viewBox="0 0 280 120" role="group" aria-labelledby="piano-title">
  <title id="piano-title">A playable octave of piano keys with a C major chord highlighted.</title>
  {WHITE.map(({ note, midi }, i) => (
    <rect
      class:list={['key', 'white', { lit: CHORD.has(note) }]}
      x={i * 40}
      y="0"
      width="38"
      height="118"
      rx="4"
      style={`--i: ${i}`}
      data-midi={midi}
      role="button"
      tabindex="0"
      aria-label={`${note}4`}
    />
  ))}
  {BLACK.map(({ note, midi, after }) => (
    <rect
      class="key black"
      x={after * 40 + 27}
      y="0"
      width="24"
      height="72"
      rx="3"
      data-midi={midi}
      role="button"
      tabindex="0"
      aria-label={`${note}4`}
    />
  ))}
  {WHITE.map(({ note }, i) => (
    <text x={i * 40 + 19} y="108" text-anchor="middle" aria-hidden="true">
      {note}
    </text>
  ))}
</svg>

<script>
  // Small synthesised piano voice: a triangle fundamental plus a quieter sine an octave up,
  // through a low-pass filter, with a fast attack and exponential decay.
  // https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API/Using_Web_Audio_API
  let audio: AudioContext | undefined;

  function context(): AudioContext {
    audio ??= new AudioContext();
    // Browsers start the context suspended until a user gesture; this call runs inside one.
    if (audio.state === 'suspended') void audio.resume();
    return audio;
  }

  function play(midi: number): void {
    const ctx = context();
    const now = ctx.currentTime;
    const frequency = 440 * 2 ** ((midi - 69) / 12);

    const envelope = ctx.createGain();
    envelope.gain.setValueAtTime(0.0001, now);
    envelope.gain.exponentialRampToValueAtTime(0.35, now + 0.01);
    envelope.gain.exponentialRampToValueAtTime(0.0001, now + 1.6);

    const filter = ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(frequency * 6, now);
    filter.frequency.exponentialRampToValueAtTime(frequency * 1.5, now + 1);
    filter.connect(envelope).connect(ctx.destination);

    const partials: Array<[OscillatorType, number, number]> = [
      ['triangle', 1, 1],
      ['sine', 2, 0.3]
    ];
    for (const [type, multiple, level] of partials) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.value = frequency * multiple;
      gain.gain.value = level;
      osc.connect(gain).connect(filter);
      osc.start(now);
      osc.stop(now + 1.7);
    }
  }

  function strike(key: SVGElement): void {
    const midi = Number(key.dataset.midi);
    if (!Number.isFinite(midi)) return;
    play(midi);
    key.classList.remove('pressed');
    // Force a reflow so the press animation restarts on repeated hits.
    void key.getBoundingClientRect();
    key.classList.add('pressed');
  }

  for (const key of document.querySelectorAll<SVGElement>('.piano .key')) {
    key.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      strike(key);
    });
    key.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      if (!event.repeat) strike(key);
    });
  }
</script>

<style>
  .key {
    cursor: pointer;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .white {
    fill: var(--key-white);
    stroke: var(--diagram-stroke);
    stroke-width: 1;
    transition: fill 0.35s ease;
  }

  /* Lit keys: accent mixed into the key colour, so it works on both key tones. */
  .white.lit {
    fill: var(--key-lit);
    stroke: var(--accent);
  }

  .black {
    fill: var(--key-black);
    stroke: var(--key-black);
    stroke-width: 1;
  }

  /* SVG elements don't reliably draw outlines, so focus is shown with the stroke. */
  .key:focus-visible {
    stroke: var(--accent);
    stroke-width: 3;
  }

  .piano text {
    fill: var(--key-black);
    opacity: 0.6;
    pointer-events: none;
    user-select: none;
  }

  :global(.interest:hover) .white.lit {
    animation: strike 0.9s var(--ease);
    animation-delay: calc(var(--i) * 70ms);
  }

  .key.pressed,
  :global(.interest:hover) .white.lit.pressed {
    animation: press 0.45s var(--ease);
    animation-delay: 0s;
  }

  @keyframes strike {
    40% {
      fill: var(--accent);
    }
  }

  @keyframes press {
    0% {
      fill: var(--accent);
    }
  }
</style>
