---
// Switches light/dark and saves the choice under the same key as the notes site.
---

<button class="theme-toggle" type="button" aria-label="Use dark theme" data-theme-toggle>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const current = (): Theme => (root.getAttribute('saved-theme') === 'dark' ? 'dark' : 'light');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const label = (button: HTMLButtonElement): void => {
    button.setAttribute('aria-label', current() === 'dark' ? 'Use light theme' : 'Use dark theme');
  };

  const apply = (theme: Theme): void => {
    root.setAttribute('saved-theme', theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Storage can be blocked; the choice then lasts for this page only.
    }
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    label(button);
    button.addEventListener('click', () => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      // Cross-fade between themes where the View Transitions API exists.
      if ('startViewTransition' in document && !reduceMotion.matches) {
        document.startViewTransition(() => apply(next));
      } else {
        apply(next);
      }
      label(button);
    });
  }
</script>

<style>
  .theme-toggle {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.3s var(--ease);
  }

  .theme-toggle:hover {
    color: var(--accent);
    background: var(--hover-fill);
  }

  .theme-toggle:active {
    transform: rotate(-20deg);
  }

  svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .moon {
    display: none;
  }

  :global(:root[saved-theme='dark']) .sun {
    display: none;
  }

  :global(:root[saved-theme='dark']) .moon {
    display: block;
  }
</style>
