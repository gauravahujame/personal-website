---
interface Props {
  /** Two-digit position in the page narrative, e.g. "02". */
  index: string;
  /** Short running label next to the number. */
  kicker: string;
  title: string;
  /** Sets the heading id so the section can reference it with aria-labelledby. */
  id: string;
  subtitle?: string;
}

const { index, kicker, title, id, subtitle } = Astro.props;
---

<header class="section-header" data-reveal>
  <p class="meta kicker">
    <span class="index">{index}</span>
    <span aria-hidden="true">/</span>
    {kicker}
  </p>
  <div class="titles">
    <h2 id={id}>{title}</h2>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <slot />
  </div>
</header>

<style>
  /* Editorial running head: a hairline, the section number, then the title. */
  .section-header {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-subtle);
    margin-bottom: 2.5rem;
  }

  .kicker {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    text-transform: lowercase;
  }

  .index {
    color: var(--accent);
  }

  /* h2 scale from the garden, one step larger on wide screens. */
  h2 {
    font-size: 1.875rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .subtitle {
    margin: 0.75rem 0 0;
    max-width: 36rem;
    font-size: 1.1875rem;
    color: var(--ink-muted);
  }

  @media (min-width: 640px) {
    h2 {
      font-size: 2.5rem;
    }

    .subtitle {
      font-size: 1.28125rem;
    }
  }

  @media (min-width: 1024px) {
    .section-header {
      grid-template-columns: 14rem 1fr;
      column-gap: 2rem;
      margin-bottom: 3.5rem;
    }

    .kicker {
      padding-top: 0.9rem;
    }

    h2 {
      font-size: 2.75rem;
    }
  }
</style>
