---
interface Props {
  items: string[];
  label?: string;
}

const { items, label = 'Built with' } = Astro.props;
---

<ul class="stack meta" aria-label={label}>
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>

<style>
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
  }

  /* Items separated by thin slashes, like technical annotations. */
  li + li::before {
    content: '/';
    margin: 0 0.5rem;
    color: var(--ink-faint);
  }
</style>
