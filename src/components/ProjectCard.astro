---
import type { Project } from '../data/projects';
import StatusBadge from './StatusBadge.astro';
import StackList from './StackList.astro';
import Visual from './diagrams/Visual.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const titleId = `project-${project.id}-title`;
---

<article
  class:list={['project', 'card', `project--${project.layout}`]}
  id={`project-${project.id}`}
  aria-labelledby={titleId}
  data-reveal
>
  <div class="text">
    <div class="topline">
      <span class="meta number">{number}</span>
      {project.status && <StatusBadge status={project.status} note={project.statusNote} />}
    </div>
    <h3 id={titleId}>{project.name}</h3>
    <p class="tagline">{project.tagline}</p>
    <p class="why small">{project.why}</p>

    <details>
      <summary class="ui">
        <span>How it works</span>
        <span class="chev" aria-hidden="true">
          +
        </span>
      </summary>
      <ul class="details small">
        {project.details.map((detail) => (
          <li>{detail}</li>
        ))}
      </ul>
    </details>

    <div class="footer">
      <StackList items={project.stack} />
      <p class="links">
        {project.links.map((link) => (
          <a class="ext ui" href={link.href}>
            {link.label}
            <span class="sr-only"> for {project.name}</span>
          </a>
        ))}
      </p>
    </div>
  </div>

  <div class="visual diagram-frame">
    <Visual name={project.visual} />
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: 1.75rem;
    padding: 1.5rem;
    transition:
      box-shadow 0.35s var(--ease),
      transform 0.35s var(--ease),
      border-color 0.35s ease;
  }

  .project:hover {
    box-shadow: var(--shadow-lift);
    border-color: color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .number {
    color: var(--accent);
  }

  h3 {
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.125rem;
    font-weight: 450;
    font-stretch: 98%;
    line-height: 1.45;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .why {
    color: var(--ink-text);
    margin-bottom: 1rem;
  }

  /* ── Progressive disclosure ── */
  details {
    border-top: 1px solid var(--line-subtle);
    border-bottom: 1px solid var(--line-subtle);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent);
  }

  .chev {
    font-family: var(--codeFont);
    transition: transform 0.25s var(--ease);
  }

  details[open] .chev {
    transform: rotate(45deg);
  }

  .details {
    list-style: none;
    padding-bottom: 1rem;
    color: var(--ink-text);
  }

  .details li {
    position: relative;
    padding-left: 1.1rem;
    margin-top: 0.4rem;
  }

  .details li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .footer {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 1rem;
  }

  .visual {
    align-self: center;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .project {
      padding: 2rem;
    }

    h3 {
      font-size: 1.875rem;
    }
  }

  /* ── Layouts ── */
  /* Feature: text and an interactive diagram side by side. */
  @media (min-width: 1024px) {
    .project--feature {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 3rem;
      padding: 2.5rem;
    }

    .project--feature h3 {
      font-size: 2.25rem;
    }

    .project--feature .visual {
      padding: 1.5rem;
      background: var(--well);
      border-radius: var(--radius-media);
    }

    /* Half: visual on top, text below. */
    .project--half {
      grid-template-rows: auto 1fr;
    }

    .project--half .visual {
      order: -1;
    }

    /* Wide: text left, a long graph right. */
    .project--wide {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: 3rem;
      padding: 2.5rem;
    }
  }
</style>
