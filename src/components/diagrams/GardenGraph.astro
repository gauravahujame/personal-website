---
// The garden's own note graph, from the "How the notes connect" diagram on its home page.
interface GraphNode {
  id: string;
  label: string;
  x: number;
  y: number;
  stage: 'seedling' | 'budding' | 'evergreen';
}

const NODES: GraphNode[] = [
  { id: 'dg', label: 'Digital gardens', x: 70, y: 60, stage: 'evergreen' },
  { id: 'en', label: 'Evergreen notes', x: 210, y: 34, stage: 'budding' },
  { id: 'zk', label: 'Zettelkasten', x: 350, y: 30, stage: 'budding' },
  { id: 'gl', label: 'Gall’s law', x: 170, y: 132, stage: 'evergreen' },
  { id: 'dm', label: 'Deep modules', x: 310, y: 112, stage: 'evergreen' },
  { id: 'ha', label: 'Home automation', x: 300, y: 186, stage: 'seedling' },
  { id: 'df', label: 'Dotfiles', x: 450, y: 136, stage: 'budding' },
  { id: 'w12', label: 'Why twelve notes', x: 600, y: 48, stage: 'evergreen' },
  { id: 'lc', label: 'Live coding music', x: 560, y: 176, stage: 'seedling' }
];

const EDGES: [string, string][] = [
  ['dg', 'en'],
  ['en', 'zk'],
  ['dg', 'gl'],
  ['gl', 'dm'],
  ['gl', 'ha'],
  ['dm', 'df'],
  ['w12', 'lc'],
  ['lc', 'df']
];

const byId = new Map(NODES.map((node) => [node.id, node]));
const RADIUS: Record<GraphNode['stage'], number> = { seedling: 4, budding: 5.5, evergreen: 7 };
---

<svg class="diagram graph" style="--vbw: 680" viewBox="0 0 680 220" role="img" aria-labelledby="garden-title">
  <title id="garden-title">
    Part of the garden's note graph: digital gardens link to evergreen notes and Gall's law, which links to deep modules
    and home automation; music notes connect through live coding to dotfiles.
  </title>
  {EDGES.map(([from, to]) => {
    const a = byId.get(from);
    const b = byId.get(to);
    return a && b ? <line class="d-line edge" x1={a.x} y1={a.y} x2={b.x} y2={b.y} /> : null;
  })}
  {NODES.map((node, index) => (
    <g class="node" style={`--i: ${index}`}>
      <circle class:list={['dot', node.stage]} cx={node.x} cy={node.y} r={RADIUS[node.stage]} />
      <text x={node.x} y={node.y - RADIUS[node.stage] - 7} text-anchor="middle">
        {node.label}
      </text>
    </g>
  ))}
</svg>

<ul class="legend meta" aria-label="Growth stages">
  <li>
    <span class="dot-key seedling" aria-hidden="true"></span>seedling
  </li>
  <li>
    <span class="dot-key budding" aria-hidden="true"></span>budding
  </li>
  <li>
    <span class="dot-key evergreen" aria-hidden="true"></span>evergreen
  </li>
</ul>

<style>
  .graph .dot {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.5;
    transition: transform 0.4s var(--ease);
    transform-box: fill-box;
    transform-origin: center;
  }

  .graph .dot.evergreen {
    fill: var(--accent);
  }

  .graph .dot.budding {
    fill: var(--accent-fill-strong);
  }

  /* Nodes breathe in sequence when the card is hovered. */
  :global(.project:hover) .graph .dot {
    transform: scale(1.25);
    transition-delay: calc(var(--i) * 40ms);
  }

  .legend {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dot-key {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--accent);
  }

  .dot-key.evergreen {
    background: var(--accent);
  }

  .dot-key.budding {
    background: var(--accent-fill-strong);
  }

  .dot-key.seedling {
    width: 7px;
    height: 7px;
  }
</style>
